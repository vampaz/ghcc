{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "astro": true,
  "ignorePatterns": [
    "PLAN.md",
    "dist/**",
    ".astro/**",
    ".cache/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "blob-report/**"
  ]
}
