    "test:e2e": "playwright test",
    "record-fixtures": "GHCC_RECORD=1 node scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/vue": "^7.1.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "dompurify": "^3.5.0",
    "mermaid": "^12.3.0",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
